<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do not rewrite if the file or folder physically exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Map clean URL to .html if exists (e.g. /login -> login.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3. Fallback all remaining non-file routes to index.html / Next.js router
  RewriteRule ^ index.html [L]
</IfModule>
